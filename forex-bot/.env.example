# ═══════════════════════════════════════════
#  FOREX ANALIZ BOT V1 — .env namunasi
#  cp .env.example .env  →  o'z qiymatlaringizni kiriting
# ═══════════════════════════════════════════

# Telegram Bot Token (@BotFather dan)
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Admin Telegram ID lari (vergul bilan)
ADMIN_IDS=123456789,987654321

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/forex_bot

# Web Panel URL — Replit URL yoki o'z domeningiz
# Bu URL Telegram WebApp uchun HTTPS bo'lishi SHART
# Misol: https://forex-bot.username.repl.co
WEB_PANEL_URL=https://your-replit-url.repl.co

# Twelve Data (forex/oltin narxlari)
# https://twelvedata.com
TWELVE_DATA_API_KEY=your_twelve_data_key

# OpenAI (AI izohi + screenshot tahlil)
# https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key

# AI modeli
OPENAI_MODEL=gpt-4o

# Binance (kripto — bepul, API key shart emas)
BINANCE_BASE_URL=https://api.binance.com

LOG_LEVEL=INFO
