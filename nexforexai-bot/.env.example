# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Twelve Data API key (free tier: https://twelvedata.com/pricing)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Anthropic API key for AI-generated explanations (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Postgres connection (docker-compose sets this automatically for the bot service)
DATABASE_URL=postgresql+asyncpg://nexforex:nexforex@db:5432/nexforexai

# Payment provider token from @BotFather -> Payments (Payme/Click/Stripe etc.)
PAYMENT_PROVIDER_TOKEN=

# Comma-separated Telegram user IDs allowed to run /grant admin command
ADMIN_IDS=123456789
