modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Forex Analiz Bot"

[[workflows.workflow]]
name = "Forex Analiz Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd forex-bot && python run.py"

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 8000
externalPort = 80
